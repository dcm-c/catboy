{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "catboy",
    "compatibility_date": "2026-07-24",
    "main": "src/index.js",
    "observability": {
        "enabled": true
    },
    "assets": {
        "directory": "./public"
    },
    "compatibility_flags": [
        "nodejs_compat"
    ],
    "kv_namespaces": [
        {
            "binding": "REDDIT_CACHE",
            "id": "ae6ead97d687423d86e7c4dc65bbf72c"
        }
    ],
    "triggers": {
        "crons": [
            "*/5 * * * *"
        ]
    }
}